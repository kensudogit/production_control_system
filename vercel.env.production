# Vercel本番環境変数設定
# これらの変数はVercel DashboardまたはCLIで設定してください

# アプリケーション設定
NODE_ENV=production
VITE_NODE_ENV=production

# API設定
VITE_API_BASE_URL=https://production-control-system.vercel.app/api
NEXT_PUBLIC_API_URL=https://production-control-system.vercel.app/api

# OpenAI API Key (オプション - AI予測機能を使用する場合)
# VITE_OPENAI_API_KEY=your-openai-api-key-here

# 認証設定
# JWT_SECRET=your-jwt-secret-key-here
# AUTH_SECRET=your-auth-secret-key-here

# データベース設定（外部サービス使用時）
# DATABASE_URL=postgresql://user:password@host:port/database
# REDIS_URL=redis://user:password@host:port

# 監視・アナリティクス
# VERCEL_ANALYTICS_ID=your-analytics-id
# SENTRY_DSN=your-sentry-dsn

# 機能フラグ
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
ENABLE_PERFORMANCE_MONITORING=true

# セキュリティ設定
CORS_ORIGIN=https://production-control-system.vercel.app
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# パフォーマンス設定
CACHE_TTL=300
REDIS_TTL=3600

# Vercel設定
VERCEL=1
VERCEL_ENV=production
